APP_NAME=SINOP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Keep the same timezone as the old app's .env (e.g. Asia/Manila).
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SINOP runs on MariaDB/MySQL (the reports use MySQL date functions).
# Development uses sinop_dev, a copy built from an export of the old system:
#   php artisan sinop:import-legacy path\to\cims.sql --database=sinop_dev
# Rebuild it any time (add --replace, and --force while .env points at it).
# Automated tests use in-memory SQLite (phpunit.xml) and never touch MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sinop_dev
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Live updates and notifications: Berth's Soketi app (Pusher protocol).
# Values come from Berth's WebSocket tab ("Copy as .env"); see SKILL.md.
# Until they are filled in, the app works and pages check for news every minute.
BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Uploads (e-signatures, profile photos, property images) go to the system's
# S3 bucket in Berth (Garage): values from Berth's S3 tab, "Copy as .env".
# The bucket stays private; the app serves the files at /files/... to signed-in users.
# UPLOADS_DISK=public keeps them in storage/app/public (no bucket needed).
# Existing files: php artisan sinop:copy-uploads [folder]
UPLOADS_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=garage
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
# Each environment has its own folder in the bucket, named after APP_ENV:
# local/ on a laptop, production/ on the server. To use another name: AWS_ROOT=name

VITE_APP_NAME="${APP_NAME}"

# Server side (publishing). Production: Soketi's internal Coolify host, http, 6001.
# Local development: the public host, 443, https (the internal name won't resolve).
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# Browser side (read at runtime by config/broadcasting.php). Never add the secret here.
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
